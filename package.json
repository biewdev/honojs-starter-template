{
  "name": "honojs-starter-template",
  "version": "0.2.0",
  "scripts": {
    "dev": "bun run --hot index.ts",
    "build": "bun build index.ts --compile --outfile server",
    "prettier": "prettier ./ --check",
    "prettier:fix": "prettier ./ --write",
    "fix": "bun run prettier:fix && bun outdated"
  },
  "dependencies": {
    "hono": "^4.11.9"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^25.2.2",
    "prettier": "^3.8.1"
  }
}
